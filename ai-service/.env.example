# --- LLM (any OpenAI-compatible endpoint, or anthropic) ---
LLM_PROVIDER=deepseek            # deepseek | openai | anthropic | fake (offline, tests only)
LLM_MODEL=deepseek-chat          # e.g. gpt-4o-mini for openai, claude-sonnet-5-5 for anthropic
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com   # leave empty for openai/anthropic defaults

# --- Services ---
BACKEND_URL=http://localhost:3000/api
TOOL_TRANSPORT=rest              # rest | mcp  (mcp = tools go through the bundled MCP server)

# --- Optional ---
# CLINIC_TODAY=2026-10-22        # pin "today" for a reproducible demo
# CLINIC_TIMEZONE=America/New_York
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# Memory (defaults shown)
# SHORT_TERM_MAX_TOKENS=1200     # short-term window budget; on overflow the oldest turns are folded into a summary
# MEMORY_ENABLED=true            # long-term memory across sessions
# MEMORY_RETENTION_DAYS=365
# Tracing (optional): OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 (also for the backend; scripts/demo-up.sh sets it)
# Speech-to-text for /summarize/audio
# WHISPER_MODEL=small             # tiny | base | small | medium
# WHISPER_PRELOAD=true            # load (first start: download ~480 MB) at startup in the background
# Evaluation only, never in production: return the facts behind each answer for the groundedness judge
# EVAL_EXPOSE_GROUNDING=false
