# Easiest: ./scripts/langfuse-env.sh generates .env with random secrets. Or copy to .env and fill every empty value (openssl rand -hex 32). .env is gitignored.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9090
# headless initialisation: org, project, API keys and a login are created on first start
LANGFUSE_INIT_ORG_ID=clinicpilot
LANGFUSE_INIT_ORG_NAME=ClinicPilot
LANGFUSE_INIT_PROJECT_ID=clinicpilot-ai
LANGFUSE_INIT_PROJECT_NAME=ClinicPilot AI
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=demo@clinicpilot.local
LANGFUSE_INIT_USER_NAME=ClinicPilot Demo
LANGFUSE_INIT_USER_PASSWORD=
